# RankAlpha Frontend – Local Environment (example)
# ------------------------------------------------
# Copy this file to `.env.local` and edit values as needed.
# Never commit secrets. `.env.local` is for local/dev only.

# ------------------------------------------------
# API base URLs
# ------------------------------------------------
# Public base URL used by the browser when calling the backend API.
NEXT_PUBLIC_API_URL=http://localhost:6080

# Internal base URL used by the Next.js server runtime (e.g., when proxying
# /api/* routes to the backend while running under Docker Compose). If unset,
# the server falls back to NEXT_PUBLIC_API_URL.
# NOTE: do NOT include `/api/v1` here; the frontend adds the backend prefix.
#INTERNAL_API_URL=http://api:6080

# Port the Next.js server listens on (optional; default 3000)
#PORT=3000

# Optional WebSocket URL if the UI needs it (not required for contact form)
#NEXT_PUBLIC_WS_URL=ws://localhost:6080

# ------------------------------------------------
# Contact Form & Email Delivery
# Uses backend `POST /api/v1/ops/email` (centralized SMTP/Gmail in API env).
# Provide the admin bearer token expected by ops routes (server-side only).
#BACKEND_ADMIN_BEARER_TOKEN=

# Optional: these affect only the outbound payload (sender/recipient override)
# and are passed server-side to the backend ops/email. If unset, backend env
# decides recipients/sender via SMTP_TO_ALERTS / SMTP_FROM (or Gmail aliases).
#CONTACT_FROM=RankAlpha <no-reply@example.com>
#CONTACT_TO=info@rankalpha.io
# ------------------------------------------------

# Legacy Resend/SMTP settings removed; the frontend no longer sends email directly.

# ------------------------------------------------
# Anti‑bot (Cloudflare Turnstile)
# If TURNSTILE vars are provided, the form requires a valid captcha.
# The client uses the site key; the server verifies with the secret.
# Docs: https://developers.cloudflare.com/turnstile/
# ------------------------------------------------

# Public site key used by the browser widget
#NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Secret key verified server‑side in the route handler
#TURNSTILE_SECRET_KEY=
