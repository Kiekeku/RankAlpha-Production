# TradeExec Environment Configuration
# Copy this file to .env and fill in your actual values

# Logging
# LOG_LEVEL can be DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Broker service HTTP API auth (recommended)
# Protects: /accounts, /signal, /report, /rates/*, /price/* (health is open).
# Clients may send either X-RA-Service-Token or Authorization: Bearer <token>.
BROKER_SERVICE_TOKEN=your_service_token_here

# IMPORTANT: How account selection works for trade_execution
# - The CLI argument must match one of the values from ACCOUNT{N}_ACCOUNT_NUMBER below.
#   Example: if ACCOUNT1_ACCOUNT_NUMBER=DU-changeme, run:
#   uv run -m tradeexec.trade_execution DU-changeme
# - The legacy variable ACCOUNT_NUMBER is NOT used by trade_execution and will be ignored.
# - If you do not pass an argument, trade_execution uses the first configured account
#   (ACCOUNT1_...). If no multi-account entries exist, it exits with an error.

# Legacy Single Account Configuration (not used by trade_execution)
IB_ACCOUNT_ID=DU-changeme
IB_OAUTH_CONSUMER_KEY=your_consumer_key_here
IB_OAUTH_ACCESS_TOKEN=your_access_token_here
IB_OAUTH_ACCESS_TOKEN_SECRET=your_access_token_secret_here
IB_OAUTH_ENCRYPTION_KEY_FP=private_encryption.pem
IB_OAUTH_SIGNATURE_KEY_FP=private_signature.pem
IB_OAUTH_DH_PRIME=your_dh_prime_here
# IBIND_CACERT=path/to/custom/ca/bundle.pem

# Multiple Account Configuration (used by trade_execution)
# Account 1 Configuration
# Set this to the exact account number you will pass on the CLI.
ACCOUNT1_ACCOUNT_NUMBER=DU-changeme
ACCOUNT1_USE_SNAPSHOT=False
ACCOUNT1_EXECUTE_ORDER=True
ACCOUNT1_CLOSE_UNACCOUNTED_POSITIONS=True
ACCOUNT1_WAIT_FOR_CONFIRMATION=False
ACCOUNT1_OPTIMIZE_PRICE=False
ACCOUNT1_HEDGE_THRESHOLD=0.9

# Account 1 Broker OAuth (for placing orders)
ACCOUNT1_BROKER_OAUTH_CONSUMER_KEY=your_broker_consumer_key_here
ACCOUNT1_BROKER_OAUTH_ACCESS_TOKEN=your_broker_access_token_here
ACCOUNT1_BROKER_OAUTH_ACCESS_TOKEN_SECRET=your_broker_access_token_secret_here
ACCOUNT1_BROKER_OAUTH_ENCRYPTION_KEY_FP=private_encryption.pem
ACCOUNT1_BROKER_OAUTH_SIGNATURE_KEY_FP=private_signature.pem
# ACCOUNT1_BROKER_OAUTH_DH_PRIME=your_broker_dh_prime_here

# Account 1 Market Data OAuth (if different from broker)
# If not specified, broker OAuth will be used for market data
# ACCOUNT1_MARKET_OAUTH_CONSUMER_KEY=your_market_consumer_key_here
# ACCOUNT1_MARKET_OAUTH_ACCESS_TOKEN=your_market_access_token_here
# ACCOUNT1_MARKET_OAUTH_ACCESS_TOKEN_SECRET=your_market_access_token_secret_here
# ACCOUNT1_MARKET_OAUTH_ENCRYPTION_KEY_FP=market_encryption.pem
# ACCOUNT1_MARKET_OAUTH_SIGNATURE_KEY_FP=market_signature.pem

# Account 1 Trading Systems
ACCOUNT1_SYSTEM_NAME1=FixedSizeMomentum0-Hyper
ACCOUNT1_TRADING_FUND1=BuyingPower
ACCOUNT1_POSITION_ALLOCATION_PERCENT1=0.25

ACCOUNT1_SYSTEM_NAME2=FixedSizeMomentum1
ACCOUNT1_TRADING_FUND2=BuyingPower
ACCOUNT1_POSITION_ALLOCATION_PERCENT2=0.25

ACCOUNT1_SYSTEM_NAME3=FixedSizeMomentum0
ACCOUNT1_TRADING_FUND3=BuyingPower
ACCOUNT1_POSITION_ALLOCATION_PERCENT3=0.25

ACCOUNT1_SYSTEM_NAME4=ShortMeanReversion1
ACCOUNT1_TRADING_FUND4=BuyingPower
ACCOUNT1_POSITION_ALLOCATION_PERCENT4=0.07

# Account 2 Configuration (Example)
# ACCOUNT2_ACCOUNT_NUMBER=U2816353
# ACCOUNT2_USE_SNAPSHOT=True
# ACCOUNT2_EXECUTE_ORDER=True
# ACCOUNT2_CLOSE_UNACCOUNTED_POSITIONS=False
# ACCOUNT2_WAIT_FOR_CONFIRMATION=True
# ACCOUNT2_OPTIMIZE_PRICE=True
# ACCOUNT2_HEDGE_THRESHOLD=0.99

# Account 2 Broker OAuth
# ACCOUNT2_BROKER_OAUTH_CONSUMER_KEY=your_broker2_consumer_key_here
# ACCOUNT2_BROKER_OAUTH_ACCESS_TOKEN=your_broker2_access_token_here
# ACCOUNT2_BROKER_OAUTH_ACCESS_TOKEN_SECRET=your_broker2_access_token_secret_here

# Account 2 Market Data OAuth (using different account)
# ACCOUNT2_MARKET_OAUTH_CONSUMER_KEY=your_market2_consumer_key_here
# ACCOUNT2_MARKET_OAUTH_ACCESS_TOKEN=your_market2_access_token_here
# ACCOUNT2_MARKET_OAUTH_ACCESS_TOKEN_SECRET=your_market2_access_token_secret_here

# Account 2 Trading Systems
# ACCOUNT2_SYSTEM_NAME1=FixedSizeMomentum0-Hyper
# ACCOUNT2_POSITION_ALLOCATION_PERCENT1=0.125
# ... etc

# Market Hours Configuration
MARKET_OPEN_TIME=09:30:00
MARKET_CLOSE_TIME=16:00:00

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=123456789

# Test Configuration
TEST_SYMBOL=AAPL
TEST_QUANTITY=1
# IMPORTANT: Use a separate bot token for testing to avoid getUpdates conflicts
# Create a dedicated test bot via @BotFather to avoid conflicts with production
TEST_TELEGRAM_BOT_TOKEN=your_test_telegram_bot_token_here
TEST_TELEGRAM_CHAT_ID=123456789

# Email Configuration
GMAIL_SENDER=your_sender@gmail.com
GMAIL_RECIPIENT=your_recipient@email.com

# Database Configuration
SERVER=localhost
DATABASE=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_ECHO=True
DATABASE_DRIVER={ODBC Driver 17 for SQL Server}
