# RankAlpha Portfolio Engine Example Env
# Used by: Portfolio engine (apps/portfolio)
# Copy to: `env/local/portfolio.env` (or your chosen profile under `env/<profile>/portfolio.env`)
# Read by: apps/portfolio/src/settings.Settings (env_file includes env/<ENV>/shared.env then env/<ENV>/portfolio.env)
#
# Notes:
# - DB credentials still live in `env/<ENV>/shared.env` (BaseAppSettings).
# - This file is for portfolio-engine-specific knobs only.

# Skip writing NAV rows when computed NAV is exactly 0 (helps avoid noisy rows for empty portfolios).
PORTFOLIO_NAV_SKIP_ZERO=true

