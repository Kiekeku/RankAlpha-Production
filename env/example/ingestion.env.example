# RankAlpha Ingestion Example Env
# Used by: Docker Compose service `ingestion`
# Copy to: `env/local/ingestion.env` (or your chosen profile under `env/<profile>/ingestion.env`)
# Read by: apps/ingestion/src/settings.Settings
# Related docs: apps/ingestion/README.md, compose/docker-compose.yml

# NOTE: Newswire (collector) settings have moved to env/<env>/newswire.env.
#       See env/example/newswire.env.example for NEWS_* variables.

# Ingestion service configuration
# The ingestion app fetches historical prices (yfinance when enabled) and may write metadata to Postgres.

# Postgres database name
DATABASE_NAME=
# Postgres username
DB_USERNAME=
# Postgres password
PASSWORD=
# Postgres host (use service name in Docker Compose)
DB_HOST=
# Postgres port
DB_PORT=

# Broker service bridge (optional)
# Base URL for the broker FastAPI service. If set, ingestion will query
# `GET /price/prev-close/{symbol}` to fill the prior trading day's official close
# before falling back to a yfinance tail download. In Docker Compose, use
# `http://broker:8000` to reach the broker container on the shared network.
BROKER_SERVICE_URL=
# Service token for broker endpoints (sent as X-RA-Service-Token).
# If unset, the broker service will return 503/401 for protected endpoints.
# If you set BROKER_SERVICE_TOKEN in env/<ENV>/shared.env, you can leave this blank here.
BROKER_SERVICE_TOKEN=

# History window and inactive/reactivation detection
# Keep only the last N trading days of price history in Parquet and in Postgres.
# Older rows will be pruned from rankalpha.fact_security_price during sync.
# Default: 760
INGESTION_HISTORY_DAYS=760
# Trading calendar refresh window (default: last 365 days + next 90 days).
INGESTION_TRADING_CALENDAR_LOOKBACK_DAYS=365
INGESTION_TRADING_CALENDAR_LOOKAHEAD_DAYS=90

# Inactive/reactivation detection (used by both ingestion and API admin activity view)
# Mark a stock inactive if its last available price is this many business days
# behind the peer anchor date (Mon–Fri counted as business days).
INGESTION_INACTIVE_AFTER_MISSING_BDAYS=
# Early-warning staleness detection (alerts before symbols go inactive)
# Count a symbol as stale when its last available price is >= this many business days behind the peer anchor.
INGESTION_STALE_AFTER_MISSING_BDAYS=1
# Alert when stale symbols exceed this fraction of the run universe (default 0.05 = 5%).
INGESTION_STALE_PRICE_ALERT_RATIO_THRESHOLD=0.05
# Hard-fail ingestion when run coverage drops below this ratio.
# Coverage = symbols with a resolved last trade date OR expected-missing classification.
INGESTION_SYMBOL_SUCCESS_MIN_RATIO=0.85
# Reactivate an inactive stock if its last available price is within this many
# business days of the peer anchor date.
INGESTION_REACTIVATE_IF_WITHIN_BDAYS=
# Prefer this symbol's parquet date as the anchor if present (e.g., SPY).
INGESTION_REFERENCE_SYMBOL=
# If no reference symbol is present, use the modal last date across peers,
# requiring at least this share (0.0–1.0). Otherwise fall back to max date.
INGESTION_ANCHOR_MIN_SHARE=
# Delete parquet files for inactive symbols once their last trade date is this
# many business days behind the anchor (defaults to INGESTION_INACTIVE...).
INGESTION_PRUNE_AFTER_MISSING_BDAYS=
# Enable/disable yfinance fallback downloads (default true).
INGESTION_YFINANCE_ENABLED=true
# Timeout (seconds) per yfinance request attempt (default 20).
INGESTION_YFINANCE_TIMEOUT_SECONDS=20
# Retry count for transient yfinance failures/timeouts (default 2; total attempts = retries + 1).
INGESTION_YFINANCE_MAX_RETRIES=2
# Exponential backoff base between retries in seconds (default 0.5).
INGESTION_YFINANCE_RETRY_BACKOFF_SECONDS=0.5

# SOFR futures + FRA–OIS capture (optional)
# Enable/disable the SOFR futures job during ingestion (default true)
INGESTION_RATES_ENABLED=true

# High-yield stress tape (CCC HY OAS) – optional derived series
INGESTION_HY_STRESS_ENABLED=true
INGESTION_HY_STRESS_BENCHMARK=%CCCHYS
INGESTION_HY_STRESS_MA_WINDOW=10
INGESTION_HY_STRESS_Z_WINDOW=750

# USDX / DXY regime
INGESTION_DXY_ENABLED=true
INGESTION_DXY_BENCHMARK_NAME=$USDX
INGESTION_DXY_MA_DAYS=200
INGESTION_DXY_ROC_1M_DAYS=21
INGESTION_DXY_ROC_3M_DAYS=63
INGESTION_DXY_ROC_6M_DAYS=126
INGESTION_DXY_Z_WINDOW_DAYS=756
INGESTION_DXY_PCT_WINDOW_DAYS=1260
INGESTION_DXY_SHOCK_THRESHOLD_PCT=0.04

# Earnings calendar (Finnhub)
# Finnhub API key; required to fetch upcoming earnings.
FINNHUB_KEY=
# Enable/disable the Finnhub earnings refresh step (default true).
INGESTION_FETCH_EARNINGS=true
# Rolling window (calendar days) to request from Finnhub; defaults to 7.
INGESTION_EARNINGS_WINDOW_DAYS=7

# Price history cache warm-up (optional; enables ingestion to notify API)
# POST endpoint exposed by the API admin router (e.g., http://api:6080/api/v1/admin/prices/cache-refresh)
# Requires AUTH_SERVICE_TOKEN (set in env/<ENV>/shared.env) so ingestion can call the endpoint.
PRICE_CACHE_REFRESH_URL=
# HTTP timeout in seconds for cache refresh calls (default 15)
PRICE_CACHE_REFRESH_TIMEOUT_SECONDS=15
# Batch size when sending cache warm-up requests (default 50 symbols per POST)
PRICE_HISTORY_CACHE_REFRESH_CHUNK_SIZE=50

# Parallelism (worker threads for per‑symbol downloads)
INGESTION_WORKERS=4
# Log symbol-pool progress every N completed symbols (also logs first and last; default 100).
INGESTION_PROGRESS_LOG_EVERY=100

# Logging
# Log level for the ingestion service (DEBUG/INFO/WARNING/ERROR). Defaults to INFO.
LOG_LEVEL=INFO

# Observability / Telemetry (optional)
# Expose ingestion metrics on this port (inside the container). Compose
# injects the value automatically from INGESTION_METRICS_PORT when running in
# Docker. Override only if you run ingestion outside Compose.
# OBSERVABILITY_METRICS_PORT=9100
# OTLP collector endpoint (default assumes the otel-collector sidecar in Compose).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# Set to "true" when using an insecure (non-TLS) collector endpoint.
# OTEL_EXPORTER_OTLP_INSECURE=true

# External data (optional)
# FRED API key used by FRED macro jobs and the FRA/OIS pricer utility script.
FRED_API_KEY=your_key_here
# Rolling lookback (calendar days) for FRED macro series refreshes to catch revisions.
# Default: 5
INGESTION_FRED_LOOKBACK_DAYS=5
