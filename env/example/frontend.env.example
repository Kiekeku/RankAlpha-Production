# RankAlpha Frontend Example Env
# Used by: Docker Compose service `frontend`
# Copy to: `env/local/frontend.env` (or your chosen profile under `env/<profile>/frontend.env`)
# Read by: Next.js app via process.env (NEXT_PUBLIC_* variables are exposed to the browser)
# Related docs: apps/frontend/README.md, compose/docker-compose.yml

# Frontend (Next.js) configuration

# Base URL of the FastAPI service. When running locally, the API defaults to 6080.
NEXT_PUBLIC_API_URL=http://localhost:6080

# Public base URL where the frontend is reachable (recommended for canonicals/sitemaps).
# In Docker builds, this should also be provided via Compose interpolation (e.g., your `.compose.env` / `--env-file`).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: WebSocket URL if/when enabled in the API
# NEXT_PUBLIC_WS_URL=ws://localhost:6080

# Optional: Google Tag Manager container ID (enables analytics). Example: GTM-XXXXXXX
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Optional: Enable developer tooling flags in the UI build
# NEXT_PUBLIC_ENABLE_DEVTOOLS=true

# Optional: Toggle raw market data display (prices/fundamentals).
# When false, raw values are hidden and price charts normalize to a 100-index trend.
# NEXT_PUBLIC_SHOW_RAW_DATA=true

# Frontend refresh security (protects POST /api/refresh-data)
# Provide a long random token and give the same value to Airflow so it can
# trigger UI cache revalidation after backend updates.
# Generate: `openssl rand -hex 32`
FRONTEND_REFRESH_TOKEN=
# NextAuth (OIDC via Google) — optional for Phase 1
# Public base URL where the frontend is reachable. Set in production.
NEXTAUTH_URL=http://localhost:3000
# Secret for signing/encrypting NextAuth cookies/JWTs (generate with `openssl rand -hex 32`)
NEXTAUTH_SECRET=
# Google OAuth client (create credentials at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Shared bridge token used for calling /api/v1/auth/* from server-side routes. Keep it private and
# match the API's AUTH_SERVICE_TOKEN (you can reuse ADMIN_BEARER_TOKEN if desired).
AUTH_SERVICE_TOKEN=
# Optional: admin bearer token for server-side admin actions if AUTH_SERVICE_TOKEN isn't set.
# BACKEND_ADMIN_BEARER_TOKEN=
# How often the frontend should re-fetch a user's roles from the API (milliseconds). Defaults to 300_000 (5 minutes).
#AUTH_ROLE_REFRESH_INTERVAL_MS=300000

# Frontend admin-route security telemetry (stdout -> Promtail/Loki/Grafana)
# Emit async security events for /admin and /api/admin access attempts.
FRONTEND_ADMIN_SECURITY_LOG_ENABLED=true
# Include successful admin access events as well (false keeps signal focused on attacks).
FRONTEND_ADMIN_SECURITY_LOG_AUTHORIZED=false
# In-memory queue limit for async logging before drops are counted.
FRONTEND_ADMIN_SECURITY_LOG_QUEUE_MAX=5000
# Max events flushed in one batch write to stdout.
FRONTEND_ADMIN_SECURITY_LOG_BATCH_SIZE=200
# Flush cadence (ms) for async security log queue.
FRONTEND_ADMIN_SECURITY_LOG_FLUSH_MS=1000
# Include raw user-agent in logs (off by default for lower noise/privacy).
FRONTEND_ADMIN_SECURITY_LOG_INCLUDE_USER_AGENT=false
