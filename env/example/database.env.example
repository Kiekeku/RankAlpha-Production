# RankAlpha Database (Postgres) Example Env
# Used by: Docker Compose service `database`
# Copy to: `env/local/database.env` (or your chosen profile under `env/<profile>/database.env`)
# Read by: Docker Compose env_file; official Postgres image
# Related docs: docker/database/sql/migrations, compose/docker-compose.yml

# PostgreSQL container configuration
# Initial superuser/role name created by the official Postgres image
POSTGRES_USER=
# Password for POSTGRES_USER
POSTGRES_PASSWORD=
# Database name to create on first run
POSTGRES_DB=
# Hostname of the database service as seen by other containers (compose service name)
DB_HOST=

# Prometheus postgres-exporter (optional). Used by the `postgres-exporter` compose service.
# Format: postgresql://<user>:<password>@<host>:<port>/<db>?sslmode=disable
DATA_SOURCE_NAME=
