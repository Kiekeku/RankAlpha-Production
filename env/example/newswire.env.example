# Newswire service configuration (example template)
# Copy to env/<env>/newswire.env and adjust values per environment.

# Collector cadence
NEWS_SOURCES=rss
# Default per-source periods (seconds); if unset, Serper/RSS fall back to NEWS_POLL_INTERVAL
NEWS_GDELT_PERIOD_SEC=900
NEWS_SERPER_PERIOD_SEC=300
NEWS_RSS_PERIOD_SEC=300
# Global cadence knobs (kept for backward compatibility)
NEWS_POLL_INTERVAL=180
NEWS_POLL_INTERVAL_PRE=60
NEWS_PREMARKET_START=07:00
NEWS_PREMARKET_END=09:15
NEWS_TIMEZONE=America/New_York
NEWS_MATERIALITY_THRESHOLD=0.80
NEWS_EVENT_DUP_WINDOW_HOURS=72

# Optional TF-IDF model path (inside container, e.g., /models/newswire.joblib)
NEWS_TFIDF_MODEL_PATH=

# Serper (Google News proxy). Provide API key for production usage.
SERPER_API_KEY=
SERPER_NEWS_URL=https://google.serper.dev/news
SERPER_GL=us
SERPER_HL=en
SERPER_NEWS_QUERIES=site:businesswire.com|site:globenewswire.com|site:prnewswire.com|("earnings" OR "guidance" OR "merger" OR "acquisition" OR "bankruptcy" OR "chapter 11" OR "dividend" OR "buyback" OR "layoffs")|(site:reuters.com OR site:bloomberg.com OR site:wsj.com OR site:ft.com) ("earnings" OR "guidance" OR "merger" OR "acquisition" OR "bankruptcy")|(site:sec.gov OR site:fda.gov OR site:justice.gov OR site:cftc.gov) (charges OR fines OR settles OR sues OR approves OR blocks OR warning OR recall)|(tariff OR sanctions OR "export controls" OR "entity list") ("company" OR "issuer" OR "stock")

# GDELT configuration
GDELT_DOC_URL=https://api.gdeltproject.org/api/v2/doc/doc
GDELT_MODE=ArtList
GDELT_SORT=DateDesc
GDELT_TIMESPAN=15m
GDELT_STEP_MIN=15
GDELT_QUERY=(sourcecountry:US OR sourcecountry:CA) AND (earnings OR guidance OR merger OR acquisition OR bankruptcy OR "SEC" OR "FDA" OR "DOJ" OR "CFTC" OR recall OR dividend OR layoffs)

# RSS feeds (enable by adding `rss` to NEWS_SOURCES)
NEWS_RSS_FEEDS=[
  "https://www.federalreserve.gov/feeds/press_all.xml",
  "https://www.sec.gov/news/pressreleases.rss",
  "https://home.treasury.gov/news/press-releases/feed",
  "https://ustr.gov/press-releases/rss.xml",
  "https://www.cftc.gov/PressRoom/PressReleases/rss"
]
NEWS_RSS_PERIOD_PRE_SEC=

# OpenAI / LLM
OPENAI_API_KEY=
OPENAI_MODEL=
NEWS_LLM_MODEL=
NEWS_LLM_ENABLED=true
NEWS_LLM_AUTO=false
NEWS_LLM_MIN_SCORE=0.50
NEWS_LLM_MAX_EVENTS=5
NEWS_LLM_MAX_EVENTS_PRE=10
NEWS_LLM_PRE_ONLY=false
NEWS_LLM_FORCE_REANALYZE=false
NEWS_LLM_QUEUE_MAX_EVENTS=10
NEWS_LLM_QUEUE_WINDOW_SEC=300

# Sentiment hand-off
NEWS_SENTIMENT_ENQUEUE_ENABLED=true
NEWS_SENTIMENT_QUEUE_ENABLED=true
NEWS_SENTIMENT_ENQUEUE_MIN_EVENT_SCORE=0.85
NEWS_SENTIMENT_ENQUEUE_MIN_IMPACT_MAG=70
NEWS_SENTIMENT_SCHEDULE_FILE=/data/analysis_schedule/analysis_schedule.json

# Cursor overlap (minutes) to reduce gaps between windows
NEWS_CURSOR_OVERLAP_MIN=2

# Max catch-up window after downtime (hours). Set to 0 to disable.
NEWS_MAX_BACKFILL_HOURS=72

# Cache the eligible universe for entity mapping (seconds). Set to 0 to disable caching.
NEWS_ENTITY_UNIVERSE_CACHE_SEC=600
# Max allowable cache age (seconds) if the universe view query fails. Set to 0 to fail fast.
NEWS_ENTITY_UNIVERSE_CACHE_MAX_STALE_SEC=3600

# Body fetch guardrails
NEWS_BODY_PREFILTER_MIN=0.50
NEWS_BODY_ALLOWLIST=businesswire.com,globenewswire.com,prnewswire.com,sec.gov,fda.gov
NEWS_BODY_FETCH_TIMEOUT_SEC=10
NEWS_BODY_MAX_FETCH_BYTES=800000
NEWS_BODY_MAX_CHARS=120000
NEWS_BODY_USER_AGENT=rankalpha-newswire/1.0

# Entity mapping guardrails
NEWS_ENTITY_MIN_TICKER_LEN=3
NEWS_ENTITY_TICKER_STOPLIST=

# Queue worker configuration
NEWS_QUEUE_WORKER_SLEEP_SEC=5
NEWS_QUEUE_WORKER_ID=
NEWS_QUEUE_WORKER_MAX_ATTEMPTS=5
# Reclaim stuck `in_progress` rows after this many seconds (disabled by default; set >0 carefully).
NEWS_QUEUE_WORKER_STALE_LOCK_SEC=0
NEWS_QUEUE_WORKER_RETRY_BACKOFF_BASE_SEC=30
NEWS_QUEUE_WORKER_RETRY_BACKOFF_MAX_SEC=3600
