# RankAlpha Airflow Example Env
# Used by: Docker Compose services `airflow-web`, `airflow-scheduler`, `airflow-worker`, `airflow-init` (and related)
# Copy to: `env/local/airflow.env` (or your chosen profile under `env/<profile>/airflow.env`)
# Read by: Docker Compose env_file; Airflow reads variables via AIRFLOW__<SECTION>__<KEY>
# Related docs: infra/airflow/dags/pipeline.py, compose/docker-compose.yml

# Airflow service configuration
# These map to airflow.cfg via the AIRFLOW__<SECTION>__<KEY> convention.

# Comma-separated users allowed when using SimpleAuthManager (e.g., "admin,user1")
AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_USERS=
# Path to JSON file with user/passwords for SimpleAuthManager
AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_PASSWORDS_FILE=/opt/airflow/scripts/airflow_pw.json
# Path where DAGs are discovered inside the container
AIRFLOW__CORE__DAGS_FOLDER=/opt/airflow/dags
# External base URL for the webserver (used in links). Docker Compose overrides the
# port portion to keep it aligned with AIRFLOW_WEB_PORT when running multiple stacks.
AIRFLOW__WEBSERVER__BASE_URL=http://airflow-web:8080
# External base URL for log links in the UI (logging component). Docker Compose also
# rewrites this at runtime so that log links resolve against the configured web port.
AIRFLOW__LOGGING__BASE_URL=http://airflow-web:8080
# Days to keep task logs on disk; used by the log_cleanup DAG (see infra/airflow/dags/log_cleanup.py)
AIRFLOW_LOG_RETENTION_DAYS=30
# Days to keep sentiment service logs on disk; also used by log_cleanup DAG
SENTIMENT_LOG_RETENTION_DAYS=30
# Days to keep non-latest company reports per company; latest per company is kept unless older than COMPANY_REPORT_MAX_AGE_DAYS
COMPANY_REPORT_RETENTION_DAYS=90
COMPANY_REPORT_MAX_AGE_DAYS=365
# Port where the frontend service is reachable from within the Docker network.
FRONTEND_SERVICE_PORT=3000
# Token for calling the frontend's POST /api/refresh-data endpoint.
# Set a strong token here that matches FRONTEND_REFRESH_TOKEN in the frontend
# service. Generate with `openssl rand -hex 32`.
FRONTEND_REFRESH_TOKEN=
# Safer DAG discovery (disable for faster parse in containers)
AIRFLOW__CORE__DAG_DISCOVERY_SAFE_MODE=False
# Enable scheduler health endpoint
AIRFLOW__SCHEDULER__ENABLE_HEALTH_CHECK=True
# Port for the scheduler health check (Airflow 2.11+ uses *_SERVER_PORT)
AIRFLOW__SCHEDULER__HEALTH_CHECK_SERVER_PORT=8974
# Optional: override the internal health check port (useful when running multiple stacks)
AIRFLOW_SCHEDULER_HEALTH_PORT_INTERNAL=8974
# Store serialized DAGs for faster web UI rendering
AIRFLOW__CORE__STORE_SERIALIZED_DAGS=True
# Executor to run tasks (Celery for distributed workers)
AIRFLOW__CORE__EXECUTOR=CeleryExecutor
# Whether new DAGs start paused
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=False
# SQLAlchemy connection string for the metadata database (e.g., postgresql+psycopg2://user:pass@database:5432/airflow)
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=
# Celery broker URL (e.g., redis://cache:6379/0 or amqp://rabbitmq:5672/). When
# running multiple stacks, make sure this matches the Redis/RabbitMQ ports you
# set via the docker-compose overrides (CACHE_SERVICE_PORT, RABBITMQ_SERVICE_PORT).
AIRFLOW__CELERY__BROKER_URL=
# Celery result backend (e.g., db+postgresql://user:pass@database:5432/airflow or
# redis://cache:6379/0)
AIRFLOW__CELERY__RESULT_BACKEND=
# RankAlpha Airflow Example Env
# Used by: Docker Compose services `airflow-web`, `airflow-scheduler`, `airflow-worker`, `airflow-init` (and related)
# Copy to: `env/local/airflow.env` (or your chosen profile under `env/<profile>/airflow.env`)
# Read by: Docker Compose env_file; Airflow reads variables via AIRFLOW__<SECTION>__<KEY>
# Related docs: infra/airflow/dags/pipeline.py, compose/docker-compose.yml

# -----------------------------------------------------------------------------
# RankAlpha pipeline toggles and Newswire blitz settings
# These are read by infra/airflow/dags/pipeline.py (via Airflow Variables or env)
# -----------------------------------------------------------------------------

# Enable AI analysis task in the DAG
AI_ENABLED=false

# Enable the pre‑market Newswire blitz task in the DAG
NEWS_ENABLED=true

# Blitz runtime minutes (collector exits after this duration)
NEWS_RUN_MINUTES=20

# Blitz polling cadence for the newswire main loop (seconds)
# Pre‑market polling interval (fallback: NEWS_POLL_INTERVAL)
NEWS_POLL_INTERVAL_PRE=45
# Baseline polling interval (non pre‑market)
NEWS_POLL_INTERVAL=120

# Materiality threshold to apply during blitz
NEWS_MATERIALITY_THRESHOLD=0.70

# -----------------------------------------------------------------------------
# Sentiment queue enqueues (infra/airflow/dags/pipeline.py)
# These are read by the pipeline DAG (Airflow Variables or env).
# -----------------------------------------------------------------------------

# Enable/disable post-earnings sentiment enqueue step.
SENTIMENT_EARNINGS_QUEUE_ENABLED=true
# Schedule follow-up sentiment for the next day at this UTC time (default: 13:00).
SENTIMENT_EARNINGS_RUN_HOUR_UTC=13
SENTIMENT_EARNINGS_RUN_MINUTE_UTC=0
# Priority + source label for queued jobs.
SENTIMENT_EARNINGS_PRIORITY=90
SENTIMENT_EARNINGS_SOURCE_LABEL=airflow-earnings

# Enable/disable consensus "new entrants" enqueue step.
SENTIMENT_CONSENSUS_QUEUE_ENABLED=true
# Minimum appearances/styles for consensus entrants (default: 1; set to 0 to disable filter).
SENTIMENT_CONSENSUS_QUEUE_MIN_APPEARANCES=1
SENTIMENT_CONSENSUS_QUEUE_MIN_STYLES=1
# Max number of new entrants to enqueue per run (default: 200; 0 = no limit).
SENTIMENT_CONSENSUS_QUEUE_LIMIT=200
# Priority + source label for queued jobs.
SENTIMENT_CONSENSUS_QUEUE_PRIORITY=70
SENTIMENT_CONSENSUS_QUEUE_SOURCE_LABEL=airflow-consensus-new

# -----------------------------------------------------------------------------
# Risk Nowcast snapshots (infra/airflow/dags/pipeline.py)
# These are best-effort DB upserts to persist the daily Nowcast state used by the
# Home page "what changed" deltas (Δ1 trading day, Δ5 trading days).
# -----------------------------------------------------------------------------

# Nowcast model version key stored in Postgres (default: nowcast_v2)
NOWCAST_MODEL_VERSION=nowcast_v2

# Optional backfill (trading days) performed by the DAG when > 0 (default: 0).
# Recommended: set to ~252 once for initial history, then revert to 0.
NOWCAST_BACKFILL_DAYS=0

# -----------------------------------------------------------------------------
# Pipeline cache warmers (infra/airflow/dags/pipeline.py)
# These are best-effort warm-up calls that reduce cold-start latency in the UI
# after the daily publish completes. Configure via Airflow Variables or env.
# -----------------------------------------------------------------------------

# Timeout (seconds) for generic cache-warm requests (default: 15)
CACHE_WARM_TIMEOUT_SECONDS=15

# Enable warming stock-detail modal endpoints for top-ranked symbols (default: true)
STOCK_DETAIL_CACHE_WARM_ENABLED=true
# If true, warm stock-detail modal endpoints for every active symbol (dim_stock.is_active = true).
# WARNING: this can generate a large number of requests (3 per symbol) and increase pipeline runtime.
STOCK_DETAIL_CACHE_WARM_ALL_ACTIVE=false
# Number of symbols to warm (default: 25; each symbol warms 3 endpoints)
STOCK_DETAIL_CACHE_WARM_LIMIT=25
# Per-request timeout (seconds) for stock-detail warming (default: CACHE_WARM_TIMEOUT_SECONDS)
STOCK_DETAIL_CACHE_WARM_TIMEOUT_SECONDS=15
# Technical series lookback (calendar days) for stock modal sparkline (default: 400)
STOCK_DETAIL_TECHNICAL_SERIES_DAYS=400

# -----------------------------------------------------------------------------
# Full price backfill DAG (infra/airflow/dags/price_backfill.py)
# -----------------------------------------------------------------------------

# Enable the full price backfill schedule (default false; manual trigger only).
PRICE_BACKFILL_ENABLED=false
# Cron schedule for the backfill DAG (default: Sunday 04:00 local time).
PRICE_BACKFILL_SCHEDULE=0 4 * * 0
# IANA timezone for the backfill schedule (defaults to PIPELINE_TIMEZONE).
PRICE_BACKFILL_TIMEZONE=America/Denver

# Optional overrides for the backfill run.
# If set, limits which symbols are processed.
PRICE_BACKFILL_SYMBOLS=
# Limit number of symbols (0 = no limit).
PRICE_BACKFILL_LIMIT=0
# Run without writing to Postgres (diagnostic only).
PRICE_BACKFILL_DRY_RUN=false

# Outlier repair (recommended to avoid numeric overflow on bad data).
PRICE_BACKFILL_REPAIR_OUTLIERS=true
PRICE_BACKFILL_MAX_RATIO=100
PRICE_BACKFILL_MAX_ABS=10000000

# -----------------------------------------------------------------------------
# Broker daily report DAG (infra/airflow/dags/broker_daily_report.py)
# -----------------------------------------------------------------------------

# Cron schedule in the configured timezone (default: 06:30 local time)
BROKER_REPORT_SCHEDULE=30 6 * * *

# IANA timezone for the schedule and trading-day guard
BROKER_REPORT_TIMEZONE=America/Denver

# Optional: comma/space-separated list of account numbers to report
# If empty, the DAG reads ACCOUNTN_ACCOUNT_NUMBER values from broker.env
BROKER_REPORT_ACCOUNTS=

# Broker service base URL (reachable from Airflow containers)
BROKER_API_URL=http://broker:8000

# Request timeouts (seconds) for the report trigger
BROKER_REPORT_CONNECT_TIMEOUT=10
BROKER_REPORT_READ_TIMEOUT=300

# -----------------------------------------------------------------------------
# Broker holdings sync DAG (infra/airflow/dags/broker_holdings_sync.py)
# -----------------------------------------------------------------------------

# Base URL for the RankAlpha API service (reachable from Airflow containers).
API_URL=http://api:6080

# Enable/disable the broker holdings sync DAG schedule.
# - When false, the DAG is created with no schedule (manual trigger only).
BROKER_HOLDINGS_SYNC_ENABLED=true

# Cron schedule in the configured timezone (default: 01:00 local time)
BROKER_HOLDINGS_SYNC_SCHEDULE=0 1 * * *

# IANA timezone for the schedule
BROKER_HOLDINGS_SYNC_TIMEZONE=America/New_York

# Request timeout (seconds) for the API calls in the holdings sync DAG
BROKER_HOLDINGS_SYNC_TIMEOUT_SECONDS=30
