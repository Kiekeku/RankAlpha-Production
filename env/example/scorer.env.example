# RankAlpha Scorer Env (example)
# Copy to env/local/scorer.env (or your profile) to customize.

# Momentum: blended composite uses sector-neutral residual and raw (70/30)

# Momentum window base weights (combined with trend t-stat weighting)
# Format: window=weight pairs, comma-separated
SCORING_MOMENTUM_WINDOW_WEIGHTS=200=1.0,90=1.0,50=1.0,30=1.0

# Momentum data quality: require >=80% valid price points within a window
SCORING_MOMENTUM_MIN_VALID_FRAC=0.8
# t-stat cap for weighting; eff_w multiplies base weight by (min(1, |t|/cap))^2
SCORING_MOMENTUM_TSTAT_CAP=3.0

# As-of date selection: require at least this fraction of eligible symbols
# to have prices on the candidate day; otherwise fall back to the next
# earlier day meeting the threshold. If none meet it, use the latest price day.
SCORING_ASOF_MIN_COVERAGE=0.5

# Momentum composite behavior
# Use 'blend' (default), 'residual', or 'raw' to set what lands in 'momentum score'
SCORING_MOMENTUM_COMPOSITE_MODE=blend
# Blend weights for residual and raw when mode=blend (will re-normalize if needed)
SCORING_MOMENTUM_RESIDUAL_WEIGHT=0.7
SCORING_MOMENTUM_RAW_WEIGHT=0.3
# Minimum group size for neutralization (median within group); fallback to market when smaller
SCORING_MOMENTUM_MIN_GROUP_SIZE=5

# Backfill tool notes:
# The backfill job (apps/scorer/src/tools/backfill_momentum.py) uses the same knobs
# to recompute momentum raw/residual/composite for recent days meeting coverage.
# Example run: uv run python -m apps.scorer.src.tools.backfill_momentum --days 21

# Valuation: sector vs market blend
SCORING_VALUATION_SECTOR_WEIGHT=0.7
SCORING_VALUATION_MARKET_WEIGHT=0.3
SCORING_VALUATION_MIN_SECTOR_SIZE=5

# Hybrid weight computation (IC + Risk Parity)
# Blend parameter (0..1): 0 => IC only, 1 => Risk Parity only
SCORING_WEIGHT_LAMBDA_RP=0.4
# Rolling window (trading days) for statistics
SCORING_WEIGHT_WINDOW_DAYS=504
# Forward return horizon (trading days) for IC
SCORING_WEIGHT_HORIZON_DAYS=21
# Force recompute weights on next scorer run (overrides monthly cache)
SCORING_WEIGHT_FORCE=false

# Data-quality alerting
# Alert when required score coverage (Momentum + Value) is missing for > X fraction of symbols.
SCORING_MISSING_REQUIRED_RATIO_ALERT_THRESHOLD=0.05
# Hard-fail scorer when as-of freshness pass-rate is too low (eligible -> asof_pass).
SCORING_ASOF_PASS_MIN_RATIO=0.5
# Hard-fail scorer when momentum-valid rate is too low among asof_pass symbols.
SCORING_MOMENTUM_VALID_MIN_RATIO=0.5

# Market Structure (CVD) regime knobs
# Windows (trading days) and z-score history
SCORING_MARKET_STRUCTURE_LOOKBACK_DAYS=320
SCORING_MARKET_STRUCTURE_TREND_WINDOW=50
SCORING_MARKET_STRUCTURE_RV_WINDOW=20
SCORING_MARKET_STRUCTURE_CORR_WINDOW=20
SCORING_MARKET_STRUCTURE_Z_WINDOW=252
# Label thresholds (z-space)
SCORING_MARKET_STRUCTURE_TREND_UP_Z=0.5
SCORING_MARKET_STRUCTURE_TREND_DOWN_Z=-0.5
SCORING_MARKET_STRUCTURE_VOL_THRESHOLD=0.0
SCORING_MARKET_STRUCTURE_CORR_THRESHOLD=0.0
SCORING_MARKET_STRUCTURE_DISP_THRESHOLD=0.0

# VIX term structure / regime
# Maximum forward-fill (trading days) for missing VIX tenors
SCORING_VIX_FFILL_LIMIT=2

# VRP (SPX vs VIX) regime
# Rolling window (trading days) for percentiles
SCORING_VRP_LOOKBACK_DAYS=720
# Trading days in the RV window (~1 month)
SCORING_VRP_TRADING_DAYS=21
# Percentile thresholds
SCORING_VRP_VRP_LOW_PCT=0.20
SCORING_VRP_VRP_HIGH_PCT=0.80
SCORING_VRP_VIX_LOW_PCT=0.33
SCORING_VRP_VIX_HIGH_PCT=0.66

# Observability / Telemetry (optional)
# Internal Prometheus metrics port (Compose sets this via SCORER_METRICS_PORT).
# Override only when running outside Docker.
# OBSERVABILITY_METRICS_PORT=9101
# OTLP collector endpoint for traces/metrics (defaults to Compose collector).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# Set to "true" when sending to an insecure collector.
# OTEL_EXPORTER_OTLP_INSECURE=true
