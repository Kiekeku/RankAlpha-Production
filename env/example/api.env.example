# RankAlpha API Example Env
# Used by: Docker Compose service `api`
# Copy to: `env/local/api.env` (or your chosen profile under `env/<profile>/api.env`)
# Read by: apps/api/src/settings.Settings (env_file=env/<ENV>/api.env)
# Related docs: apps/api/README.md, compose/docker-compose.yml

# API Service Configuration
# Human-readable service name (used in docs/metadata)
API_NAME=RankAlpha Stock Rankings API
# Semantic version of the API (for docs/headers)
API_VERSION=0.1.0
# Short description shown in OpenAPI docs
API_DESCRIPTION=FastAPI service for stock analysis and rankings

# Database Configuration (used by API service)
# These control the Postgres connection the API uses.
# Tip: In Docker Compose, use `HOST=database` and `DB_PORT=5432` (the internal port).
#      When running API on your host while DB runs via Compose port mapping, use
#      `HOST=localhost` and `DB_PORT=6543` (default mapping 6543:5432 in compose).
# Postgres database name
DATABASE_NAME=
# Postgres username
DB_USERNAME=
# Postgres password
PASSWORD=
# Postgres host (use service name in Docker Compose)
DB_HOST=database
# Postgres port for the DB connection
DB_PORT=5432
# IMPORTANT: Do NOT set `PORT` here for database. `PORT` is reserved as the
# container HTTP listen port (used by the API process). The API’s DB connector
# already reads `DB_PORT`; `PORT` is only a legacy fallback and should remain
# unset in this file to avoid confusion with `API_PORT` below.
# DB_PORT=

# SQLAlchemy connection pool tuning (QueuePool)
# Use this if you see errors like:
#   "QueuePool limit of size 5 overflow 10 reached, connection timed out, timeout 30.00"
# Defaults (if unset): pool_size=5, max_overflow=10, timeout=30s
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=60
# DB_POOL_RECYCLE_SECONDS=1800

# Redis Cache Configuration (for HTTP/data caching)
# Redis host (service name in Docker Compose)
REDIS_HOST=cache
# Redis port
REDIS_PORT=6379

# API Server Configuration (also used as the container listen port)
# Bind host for uvicorn
API_HOST=0.0.0.0
# Bind port for uvicorn (HTTP). When running in Docker Compose, this is also
# propagated to the container as `PORT` so the API listens on the same value.
API_PORT=6080
# Number of worker processes
API_WORKERS=1

# Security
# Secret key for signing tokens/cookies (replace in production)
SECRET_KEY=<change_me>
# JWT signing algorithm
ALGORITHM=HS256
# Access token lifetime (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging
# Log level for the API service (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO
# Log output format (json or console)
LOG_FORMAT=json
# Route API logs through an in-process queue listener to reduce request-thread blocking.
API_ASYNC_LOGGING_ENABLED=true
# Queue bound for async logging (set 0 only if you explicitly want unbounded growth risk).
API_ASYNC_LOGGING_QUEUE_MAXSIZE=10000

# Shared Outbound Integrations (consumed by multiple services via common Settings)
# SMTP (preferred central config for all services)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false   # set true only for port 465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=RankAlpha <no-reply@example.com>
# Optional default recipients for ops/alerts (comma-separated)
SMTP_TO_ALERTS=

# Gmail (legacy alias; falls back when SMTP_HOST is unset)
GMAIL_SENDER=
GMAIL_RECIPIENT=
GMAIL_APP_PASSWORD=
# Optional comma-separated override for budget alert recipients (defaults to SMTP_TO_ALERTS or GMAIL_RECIPIENT)
BUDGET_ALERT_RECIPIENTS=

# Telegram bot (e.g., broker confirmations)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# CORS Configuration
# List of allowed origins for browser requests
# The FastAPI app currently defaults to allowing http://localhost:3000 and http://localhost:3001
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001"]
# Allow cookies/credentials across origins
CORS_ALLOW_CREDENTIALS=true
# Allowed HTTP methods
CORS_ALLOW_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS"]
# Allowed headers
CORS_ALLOW_HEADERS=["*"]

# Application Settings
# Arbitrary environment name (development/staging/production)
ENVIRONMENT=development
# Enable debug logging and extra diagnostics
DEBUG=true
# Auto-reload code on change (development only)
RELOAD=true

# Rate Limiting (requests per minute)
# Max requests per window per client
RATE_LIMIT_REQUESTS=1000
# Window size (seconds)
RATE_LIMIT_WINDOW=60

# Pagination Defaults
# Default items per page
DEFAULT_PAGE_SIZE=50
# Upper bound for client-specified page size
MAX_PAGE_SIZE=500

# Score Calculation Weights
# Relative weights for combined score
MOMENTUM_WEIGHT=0.35

# Observability / Telemetry (optional)
# Set a custom OTLP endpoint if you are not using the built-in otel-collector.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# Set to "true" when using plain HTTP/gRPC without TLS.
# OTEL_EXPORTER_OTLP_INSECURE=true
# Override the advertised service name (defaults to rankalpha-api in Compose).
# OTEL_SERVICE_NAME=rankalpha-api
VALUE_WEIGHT=0.35
SENTIMENT_WEIGHT=0.30

# Cache TTL (Time To Live) in seconds
# Default TTL for uncategorized GET endpoints (used by HTTP cache middleware)
#CACHE_TTL_DEFAULT=180
# Rankings endpoint cache duration (/api/v1/grading/grades, /grades/batch)
CACHE_TTL_RANKINGS=300      # 5 minutes
# Stock detail endpoint cache duration (/api/v1/grading/asset/{symbol})
CACHE_TTL_STOCK_DETAIL=600  # 10 minutes
# Top performers endpoint cache duration (/api/v1/grading/top-performers)
CACHE_TTL_TOP_PERFORMERS=300 # 5 minutes
# Sectors list cache duration (/api/v1/grading/sectors)
CACHE_TTL_SECTORS=3600      # 1 hour
# Warmed price history cache TTL (default 26 hours to cover missed runs)
PRICE_HISTORY_CACHE_TTL_SECONDS=93600
# Store a small "recent history" cache alongside full history to speed up /api/v1/prices/history
# for common requests (skip=0, no date filters). Unit: number of rows (descending by date).
PRICE_HISTORY_CACHE_HEAD_ITEMS=800
# Batch size for admin price cache refresh jobs
PRICE_HISTORY_CACHE_REFRESH_CHUNK_SIZE=50
# Warmed AI analysis cache TTL (default 6 hours)
AI_ANALYSIS_CACHE_TTL_SECONDS=21600
# Batch size for admin AI analysis cache refresh jobs
AI_ANALYSIS_CACHE_REFRESH_CHUNK_SIZE=25

# Broker service bridge (FastAPI proxy -> Broker -> IBKR)
# Base URL for the broker FastAPI service. In Docker Compose, the service name is `broker`
# so the API can reach it at http://broker:8000 on the shared backend network.
BROKER_SERVICE_URL=http://broker:8000
# Service token used by the API when calling the broker service (sent as X-RA-Service-Token).
# If you set BROKER_SERVICE_TOKEN in env/<ENV>/shared.env, you can leave this blank here.
BROKER_SERVICE_TOKEN=
# Timeout (seconds) for outbound snapshot requests to the broker
BROKER_SERVICE_TIMEOUT_SECONDS=4
# Cooldown (seconds) after broker failures before retrying live price calls.
# Set to 0 to disable the cooldown.
BROKER_LIVE_DOWN_TTL_SECONDS=30
# Cache TTL (seconds) for live prices stored in Redis (set to 0 to disable caching)
BROKER_PRICE_CACHE_SECONDS=90

# Admin security
# Protect /api/v1/admin/* routes (weights/grades/news refresh, activity, recluster, etc.)
# If set, clients must send: Authorization: Bearer ${ADMIN_BEARER_TOKEN}
ADMIN_BEARER_TOKEN=
# Shared symmetric key with NextAuth for verifying session JWTs. MUST match the frontend value.
NEXTAUTH_SECRET=
# Optional: expected issuer for incoming NextAuth JWTs (set if you use a custom NEXTAUTH_URL domain)
#NEXTAUTH_ISSUER=https://app.rankalpha.com
# Shared service token for internal calls (frontend server routes, Airflow, ingestion cache warmers).
# Prefer setting this once in env/<ENV>/shared.env and leaving it blank here.
AUTH_SERVICE_TOKEN=
# Default role granted to first-time OAuth logins. Usually viewer/analyst/operator/admin.
AUTH_DEFAULT_ROLE=viewer
# Protect /api/v1/trading/* routes (external trade recommendations ingestion).
# REQUIRED for production; if unset the trading routes return 503 (disabled).
TRADING_BEARER_TOKEN=

# API Exposure / Hardening Toggles
# Disable in production if you don't want public API docs/schema.
API_DOCS_ENABLED=false
API_OPENAPI_ENABLED=false
# Internal auto-generated CRUD routes under /internal/*.
API_INTERNAL_CRUD_ENABLED=false
# Show /internal/* routes in Swagger/OpenAPI (recommended false).
API_INTERNAL_CRUD_INCLUDE_IN_SCHEMA=false
# When true, auto-generated CRUD is GET-only (no POST/PUT/DELETE).
API_READ_ONLY=false

# Middleware Toggles
# Redis-backed HTTP cache middleware for GET endpoints.
HTTP_CACHE_ENABLED=true
# Adds baseline security headers to responses (nosniff, frame deny, etc.).
SECURITY_HEADERS_ENABLED=true

# DoS Guards / Limits
# Maximum symbol count accepted by /api/v1/ai-analysis/preview.
AI_PREVIEW_MAX_SYMBOLS=200
# Max backtest date span in days for /api/v1/backtest/*.
BACKTEST_MAX_RANGE_DAYS=1825
# Max rebalance points allowed for a backtest request.
BACKTEST_MAX_REBALANCE_POINTS=1000
# Cap in-memory background prefetch tasks for /api/v1/prices/live/{symbol}.
PRICES_LIVE_PREFETCH_MAX_TASKS=250
