# Compose-time overrides (use with `docker compose --env-file .compose.env`)
# Copy to: .compose.env (next to compose/) and adjust as needed.

# SFTP credentials for the atmoz/sftp container.
SFTP_USER=foo
SFTP_PASS=secret

# Optional port overrides (examples).
#SFTP_PORT_HOST=2222
#API_PORT=6080
#FRONTEND_PORT=3000
