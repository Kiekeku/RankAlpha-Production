# RankAlpha Cache (Redis) Example Env
# Used by: Docker Compose service `cache`
# Copy to: `env/local/cache.env` (or your chosen profile under `env/<profile>/cache.env`)
# Read by: Docker Compose env_file; Redis container
# Related docs: compose/docker-compose.yml

# Redis Cache Configuration
# This file configures the Redis cache container used by API/sentiment.

# Hostname of the Redis service (used by other containers)
REDIS_HOST=cache

# Redis port inside the container
REDIS_PORT=6379

# Optional: Redis memory cap (recommended for cache workloads)
# If REDIS_MAXMEMORY is unset, the container entrypoint computes:
#   maxmemory = REDIS_MAXMEMORY_RATIO * (container memory limit or host MemTotal)
# REDIS_MAXMEMORY_RATIO=0.5
# REDIS_MAXMEMORY_POLICY=allkeys-lru
# Or set an explicit value (bytes or redis-supported units like 4gb):
# REDIS_MAXMEMORY=4gb

# Optional: Redis password; set and wire into services if you enable Redis AUTH
# REDIS_PASSWORD=
