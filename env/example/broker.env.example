# Broker (TradeExec) Example Env
# Used by: Docker Compose service `broker` and `broker-runner`
# Copy to: `env/local/broker.env` (or your chosen profile under `env/<profile>/broker.env`)
# Read by: apps/broker/tradeexec/settings.TradeExecSettings (env_file includes env/<ENV>/shared.env then env/<ENV>/broker.env)
# Related docs: apps/broker/README.md, compose/docker-compose.yml

# -----------------------------------------------------------------------------
# Broker service HTTP API auth (recommended)
# Tip: prefer setting BROKER_SERVICE_TOKEN in env/<ENV>/shared.env so API/ingestion/broker share one value.
#      Setting it here works too and overrides shared.env for the broker container.
# Protects: /accounts, /signal, /report, /rates/*, /price/* (health is open).
# Clients may send either:
#   - X-RA-Service-Token: <token>
#   - Authorization: Bearer <token>
# If unset, the broker service returns 503 for protected endpoints.
# -----------------------------------------------------------------------------
BROKER_SERVICE_TOKEN=

# -----------------------------------------------------------------------------
# Multi‑account configuration
#   Define ACCOUNT1_*, ACCOUNT2_*, ...
#   Each account supports separate OAuth for broker (orders) and market data.
# -----------------------------------------------------------------------------

# ----------------- Account 1 -----------------
ACCOUNT1_ACCOUNT_NUMBER=
ACCOUNT1_EXECUTE_ORDER=True
ACCOUNT1_WAIT_FOR_CONFIRMATION=False
ACCOUNT1_OPTIMIZE_PRICE=False
ACCOUNT1_CLOSE_UNACCOUNTED_POSITIONS=True
ACCOUNT1_HEDGE_THRESHOLD=0.95

# Broker (orders) OAuth
ACCOUNT1_BROKER_OAUTH_CONSUMER_KEY=
ACCOUNT1_BROKER_OAUTH_ACCESS_TOKEN=
ACCOUNT1_BROKER_OAUTH_ACCESS_TOKEN_SECRET=
ACCOUNT1_BROKER_OAUTH_ENCRYPTION_KEY_FP=private_encryption.pem
ACCOUNT1_BROKER_OAUTH_SIGNATURE_KEY_FP=private_signature.pem
ACCOUNT1_BROKER_OAUTH_DH_PRIME=

# Market‑data OAuth (optional; if omitted, broker OAuth is reused)
ACCOUNT1_MARKET_OAUTH_CONSUMER_KEY=
ACCOUNT1_MARKET_OAUTH_ACCESS_TOKEN=
ACCOUNT1_MARKET_OAUTH_ACCESS_TOKEN_SECRET=
ACCOUNT1_MARKET_OAUTH_ENCRYPTION_KEY_FP=
ACCOUNT1_MARKET_OAUTH_SIGNATURE_KEY_FP=
ACCOUNT1_MARKET_OAUTH_DH_PRIME=

# Whitelisted systems + allocations (optional)
# Pattern: ACCOUNT{N}_SYSTEM_NAME{M}, ACCOUNT{N}_TRADING_FUND{M}, ACCOUNT{N}_POSITION_ALLOCATION_PERCENT{M}
# Notes:
#  - Start {M} at 1 and increment contiguously (1,2,3,...) per account.
#  - {M} stops when SYSTEM_NAME{M} is missing.
#  - POSITION_ALLOCATION_PERCENT is a 0..1 fraction. Sum of all systems per account
#    should be ≤ 1.0. Values are used for visibility and future sizing logic.
#  - TRADING_FUND is a label (e.g., BuyingPower), currently informational.
ACCOUNT1_SYSTEM_NAME1=
ACCOUNT1_TRADING_FUND1=BuyingPower
ACCOUNT1_POSITION_ALLOCATION_PERCENT1=0.25

# Example: a second system for ACCOUNT1
# ACCOUNT1_SYSTEM_NAME2=
# ACCOUNT1_TRADING_FUND2=BuyingPower
# ACCOUNT1_POSITION_ALLOCATION_PERCENT2=0.25

# ----------------- Account 2 (market data only) -----------------
ACCOUNT2_ACCOUNT_NUMBER=
ACCOUNT2_EXECUTE_ORDER=False
ACCOUNT2_WAIT_FOR_CONFIRMATION=False
# Leave broker OAuth blank to prevent order placement from this account
ACCOUNT2_BROKER_OAUTH_CONSUMER_KEY=
ACCOUNT2_BROKER_OAUTH_ACCESS_TOKEN=
ACCOUNT2_BROKER_OAUTH_ACCESS_TOKEN_SECRET=
ACCOUNT2_BROKER_OAUTH_ENCRYPTION_KEY_FP=
ACCOUNT2_BROKER_OAUTH_SIGNATURE_KEY_FP=
# Market data OAuth for this account (Client-Portal Web API)
ACCOUNT2_MARKET_OAUTH_CONSUMER_KEY=
ACCOUNT2_MARKET_OAUTH_ACCESS_TOKEN=
ACCOUNT2_MARKET_OAUTH_ACCESS_TOKEN_SECRET=
ACCOUNT2_MARKET_OAUTH_ENCRYPTION_KEY_FP=paper_encryption.pem
ACCOUNT2_MARKET_OAUTH_SIGNATURE_KEY_FP=paper_signature.pem

# -----------------------------------------------------------------------------
# Market hours (local to MARKET_TIMEZONE). DST handled automatically.
# -----------------------------------------------------------------------------
MARKET_TIMEZONE=America/New_York
MARKET_OPEN_TIME=09:30:00
MARKET_CLOSE_TIME=16:00:00

# -----------------------------------------------------------------------------
# Real-time signal handling
# -----------------------------------------------------------------------------
# Allow signals without a system tag (or not in the whitelist).
# Default false: runner enforces whitelist for real-time as well.
BROKER_ALLOW_REALTIME_WITHOUT_SYSTEM=false
# Preferred tag to use for live signals; add this to the whitelist if you
# want a single catch-all entry (e.g., ACCOUNTN_SYSTEM_NAME1=real-time)
BROKER_REALTIME_SYSTEM_NAME=real-time

# -----------------------------------------------------------------------------
# Test settings (optional)
# -----------------------------------------------------------------------------
TEST_SYMBOL=AAPL
TEST_QUANTITY=1

# -----------------------------------------------------------------------------
# Notes on shared settings
#   • Database (Postgres), Gmail, and Telegram now live in `env/<ENV>/shared.env`
#     and are loaded by BaseAppSettings across services.
#   • The broker service composes both env/<ENV>/shared.env and env/<ENV>/broker.env.
# -----------------------------------------------------------------------------

# Observability / Telemetry (optional)
# Customize OTLP collector endpoint for traces/metrics (defaults to otel-collector).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# Set to "true" when the collector does not use TLS.
# OTEL_EXPORTER_OTLP_INSECURE=true
# Override the service name reported to the collector (defaults to rankalpha-broker).
# OTEL_SERVICE_NAME=rankalpha-broker

# -----------------------------------------------------------------------------
# Sentry noise control (IBKR maintenance)
# -----------------------------------------------------------------------------
# When enabled, /price/prev-close failures during the quiet window are returned as 502 JSON responses
# with WARNING logs (audited via Prometheus) and will not generate Sentry events.
# Quiet window is in Eastern Time (ET) and wraps midnight.
# BROKER_SENTRY_QUIET_HOURS_ENABLED=true
# BROKER_SENTRY_QUIET_HOURS_START_ET=20
# BROKER_SENTRY_QUIET_HOURS_END_ET=6
# Also suppress during weekends (Sat/Sun ET).
# BROKER_SENTRY_QUIET_WEEKENDS_ET=true
#
# Note: This window is also used by the broker-runner (trade execution loop) to
# downshift expected IBKR maintenance errors (e.g. "Reached max retries" on ledger)
# from ERROR→WARNING so they don't generate Sentry events.

LOG_LEVEL=DEBUG
