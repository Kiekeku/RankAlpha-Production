# RankAlpha Sentiment Example Env
# Used by: Docker Compose service `sentiment`
# Copy to: `env/local/sentiment.env` (or your chosen profile under `env/<profile>/sentiment.env`)
# Read by: apps/sentiment/src/settings.Settings
# Related docs: apps/sentiment/README.md (see “Cost‑Safety Cap (Testing)”, “Consensus Screener”), compose/docker-compose.yml

OPENAI_API_KEY=
# Optional: Override model configured in mcp_agent.config.yaml (e.g., o3, gpt-4o, gpt-4o-mini)
OPENAI_MODEL=
# Optional: Use a separate model for the planner only
OPENAI_PLANNER_MODEL=
# Token limits (optional)
# For GPT-5 family models
OPENAI_MAX_COMPLETION_TOKENS=
# For other models
OPENAI_MAX_TOKENS=
# Reasoning controls (optional)
# Disable reasoning entirely to prevent fallback to o3
OPENAI_DISABLE_REASONING=false
# Or set a specific effort (low|medium|high)
OPENAI_REASONING_EFFORT=
# Optional: on-demand run controls
# Set a symbol to run immediately (bypasses schedule)
SENTIMENT_SYMBOL=
# Force reanalysis even if already run today (true/false)
SENTIMENT_FORCE=false
# If true, require SENTIMENT_SYMBOL and exit after one run
SENTIMENT_SINGLE_SYMBOL_ONLY=false
# Enable OpenAI SDK debug logging to stdout (request details)
SENTIMENT_OPENAI_DEBUG=false
# Log full prompts and responses to file (see SENTIMENT_LOG_FILE)
SENTIMENT_LOG_PROMPTS=false

# Guardrails: shared LLM/search budgets (sentiment + newswire)
AI_DISABLE=false
AI_DRY_RUN=false
AI_RPM=120
AI_MAX_DAILY_TOKENS=5000000
AI_MAX_DAILY_COST_USD=10
AI_MAX_CONCURRENCY=4
COST_SAFETY_MARGIN=1.25
# Optional pricing overrides (JSON takes precedence over YAML)
AI_PRICING_JSON='{"models":{"^gpt-5-mini$":{"input_per_1k":0.00025,"output_per_1k":0.006}}}'
AI_PRICING_YAML=apps/common/config/pricing.yaml
# Optional search throttles (rate + per-query cost guardrails)
SEARCH_DISABLE=false
SEARCH_COST_USD=
SEARCH_SERPAPI_COST_USD=
SEARCH_GOOGLE_CSE_COST_USD=
SEARCH_SERPER_COST_USD=0.001
SEARCH_DEFAULT_COST_USD=

# Budget alert email delivery reuses backend SMTP/Gmail settings from env/<env>/api.env.
# Configure SMTP_* (or GMAIL_* legacy) there; no mail settings are needed here.

# Paths (override defaults for local runs)
# Base data dir; defaults to /data (container). For local, set to a writable folder.
SENTIMENT_DATA_DIR=
# Or set explicit output/schedule paths:
SENTIMENT_OUTPUT_DIR=
SENTIMENT_SCHEDULE_FILE=

# Optional: prompt/Responses log file (auto-created under DATA_DIR/logs if unset)
SENTIMENT_LOG_FILE=

# Worker output sizes (GPT-5 Responses API)
# Default 8192 each; increase to reduce truncation if needed
SENTIMENT_ANALYST_MAX_TOKENS=
SENTIMENT_WRITER_MAX_TOKENS=
SENTIMENT_ORCHESTRATOR_TIMEOUT_SECONDS=600

# Tool behavior
# Max characters to fetch per fetch() call if model omits it
SENTIMENT_FETCH_MAX_LENGTH=5000
# Max characters to return when converting PDFs to text/markdown (e.g., EDGAR filings)
SENTIMENT_PDF_EXTRACT_MAX_CHARS=200000
# Base URL for the RankAlpha API used by Fetch MCP (prices, etc.).
# Examples:
# - If both API and sentiment run in Docker Compose: http://api:6080
# - If API runs on the host and sentiment runs in Docker: http://host.docker.internal:6080
# - If both run on the host (no Docker): http://localhost:6080
SENTIMENT_API_BASE=
# Read timeout (seconds) for anchor price fetches from the RankAlpha API.
# Defaults to 12 when unset.
SENTIMENT_ANCHOR_API_TIMEOUT_SECONDS=15
# Cache search/fetch tool results (within TTL)
SENTIMENT_TOOL_CACHE=true
# TTL in seconds for cached tool outputs (default 86400 = 24h)
SENTIMENT_TOOL_CACHE_TTL_SECONDS=86400
# Admin endpoint to invalidate AI analysis caches after completing an analysis
AI_ANALYSIS_CACHE_URL=
AI_ANALYSIS_CACHE_TOKEN=
AI_ANALYSIS_CACHE_TIMEOUT_SECONDS=15
AI_ANALYSIS_CACHE_REFRESH_CHUNK_SIZE=25

# Redis cache (preferred; falls back to in-memory if unavailable)
# Use REDIS_URL or host/port/db/password.
REDIS_URL=
REDIS_HOST=cache
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Use lean prompts for catalyst/scenario/peer-focused reports (omit basics/ratios/no data_gaps)
SENTIMENT_USE_LEAN_REPORT=false

# SEC EDGAR MCP
# Required by the EDGAR MCP server; include name + contact per SEC guidelines
# (Set here so the value is scoped to the sentiment service.)
SEC_EDGAR_USER_AGENT=

# Serper MCP (production-preferred search)
# API key for Serper-backed search MCP server. If set and a `serper` server is
# configured in mcp_agent.config.yaml, the app prefers Serper and falls back to g-search.
SERPER_API_KEY=

# Optional: Store human analyst price target snippets (Serper HTTP API /search)
# When enabled, sentiment will fetch Serper results, sanitize them, inject them into the LLM
# for comparison, and persist the snapshot to the DB for the AI Analysis screen.
SENTIMENT_USE_SERPER_ANALYST_TARGETS=false
# Max organic results kept (defaults to 10)
SENTIMENT_SERPER_ANALYST_TARGETS_LIMIT=10

DATABASE_NAME=
DB_USERNAME=
PASSWORD=
DB_HOST=database
DB_PORT=5432

# Queue (DB-backed) integration
# Enable consuming queue items (sentiment_analysis_queue) before scheduled checks
SENTIMENT_USE_QUEUE=true
# Max queue items to process per loop iteration
SENTIMENT_QUEUE_MAX=5
# Max attempts per queue item before marking failed
SENTIMENT_QUEUE_MAX_ATTEMPTS=3
# Backoff base seconds (exponential backoff: base * 2^(attempt-1))
SENTIMENT_QUEUE_BACKOFF_BASE_SEC=300

# Schedule mode (queue | file). Use 'queue' to disable legacy JSON schedule logic.
SENTIMENT_SCHEDULE_MODE=queue

# Seconds to sleep between scheduled loop iterations (default 86400 = 24h)
SENTIMENT_LOOP_SLEEP_SEC=

# Consensus Screener (optional sentiment integration)
# Enable using the latest-day screener consensus view to run a small batch
# of top symbols before (or instead of) the normal scheduled/catalyst loop.
SENTIMENT_USE_CONSENSUS=false
# Minimum breadth to include a symbol in the batch
SENTIMENT_CONSENSUS_MIN_APPEARANCES=
SENTIMENT_CONSENSUS_MIN_STYLES=
# Max number of symbols to run per batch
SENTIMENT_CONSENSUS_LIMIT=
# If true, run only the batch once and exit (useful for Airflow one-off tasks)
SENTIMENT_CONSENSUS_BATCH_ONLY=false

# Re-run guard: skip if last analysis is within N days (default 1 = same day)
SENTIMENT_SKIP_IF_WITHIN_DAYS=1

# Testing safeguard: cap total analyses per scheduled run
# Set to a small number (e.g., 1–5) while iterating locally to limit
# OpenAI calls and cost. Omit or set to 0 for no cap.

# Observability / Telemetry (optional)
# Expose sentiment metrics on this port (Compose uses SENTIMENT_METRICS_PORT -> 9102 by default).
# OBSERVABILITY_METRICS_PORT=9102
SENTIMENT_MAX_ANALYSES=

# Observability / Telemetry (optional)
# OTLP collector endpoint (defaults to otel-collector inside Docker Compose).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# Set to "true" when the collector does not use TLS.
# OTEL_EXPORTER_OTLP_INSECURE=true
# Override the service name reported to the collector.
# OTEL_SERVICE_NAME=rankalpha-sentiment
