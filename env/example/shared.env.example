# Shared settings loaded by BaseAppSettings (used by all Python services)
# Copy to env/<ENV>/shared.env and fill in required values.

# Database (PostgreSQL)
DATABASE_NAME=
DB_USERNAME=
PASSWORD=
DB_HOST=database
DB_PORT=5432

# Redis (optional; used by API cache, sentiment tool cache, price cache warmers)
REDIS_URL=
REDIS_HOST=cache
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# OpenAI / LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_MAX_TOKENS=
OPENAI_MAX_COMPLETION_TOKENS=

# Logging
LOG_LEVEL=INFO
LOG_SLOW_REQUEST_MS=

# Service tokens (optional)
# Shared service-to-service token used by:
# - API: allows trusted calls to admin/operator endpoints (alternative to ADMIN_BEARER_TOKEN)
# - Ingestion/Airflow: used for cache warmers and refresh hooks when explicit tokens are unset
# - Frontend (server-side): used for internal calls to /api/v1/auth/* and admin ops (set separately in frontend.env)
AUTH_SERVICE_TOKEN=
# Token required by the broker FastAPI service for non-/health endpoints.
# The API and ingestion use this token when calling the broker service.
BROKER_SERVICE_TOKEN=

# Outbound email / budget alerts
BUDGET_ALERT_RECIPIENTS=

# SMTP / Email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO_ALERTS=
GMAIL_SENDER=
GMAIL_RECIPIENT=
GMAIL_APP_PASSWORD=

# Sentry (optional; centralized exception inbox for prod)
# Leave unset to disable.
SENTRY_DSN=
# Master toggle (defaults true). Useful when DSN is present but you want to disable temporarily.
SENTRY_ENABLED=true
SENTRY_ENVIRONMENT=prod
# Error event sampling (0.0..1.0). Keep at 1.0 until quota becomes an issue.
SENTRY_ERROR_SAMPLE_RATE=1.0
# Performance tracing (0.0..1.0). Default off; enable only when needed.
SENTRY_TRACES_SAMPLE_RATE=0.0
# Comma-separated logger names to exclude from Sentry (e.g., yfinance,yfinance.base).
SENTRY_IGNORE_LOGGERS=
# Optional metadata
SENTRY_RELEASE=
SENTRY_SERVER_NAME=
