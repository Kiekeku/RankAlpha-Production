# RankAlpha Flyway Example Env
# Used by: Docker Compose service `flyway`
# Copy to: `env/local/flyway.env` (or your chosen profile under `env/<profile>/flyway.env`)
# Read by: Flyway container
# Related docs: docker/database/sql/migrations, compose/docker-compose.yml

# Flyway database migrations configuration
# JDBC URL to the target database (e.g., jdbc:postgresql://database:5432/rankalpha)
FLYWAY_URL=
# Database user with permission to apply migrations
FLYWAY_USER=
# Password for FLYWAY_USER
FLYWAY_PASSWORD=
# Comma-separated list of schemas to manage (e.g., rankalpha)
FLYWAY_SCHEMAS=
# Number of times Flyway retries connecting before failing
FLYWAY_CONNECT_RETRIES=10
# Locations for migration scripts (classpath or filesystem paths)
FLYWAY_LOCATIONS=
