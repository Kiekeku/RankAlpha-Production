{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        { "expr": "max(up{job=\"node\"})", "legendFormat": "up", "refId": "A" }
      ],
      "title": "Host Up",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percent" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "id": 2,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "showPoints": "never",
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{job=\"node\", mode=\"idle\"}[5m])))",
          "legendFormat": "cpu %",
          "refId": "A"
        }
      ],
      "title": "CPU Usage",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "id": 3,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "showPoints": "never",
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        { "expr": "node_load1{job=\"node\"}", "legendFormat": "load1", "refId": "A" },
        { "expr": "node_load5{job=\"node\"}", "legendFormat": "load5", "refId": "B" },
        { "expr": "node_load15{job=\"node\"}", "legendFormat": "load15", "refId": "C" }
      ],
      "title": "Load Average",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percent" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "id": 4,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "showPoints": "never",
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "expr": "100 * (1 - (node_memory_MemAvailable_bytes{job=\"node\"} / node_memory_MemTotal_bytes{job=\"node\"}))",
          "legendFormat": "mem used %",
          "refId": "A"
        }
      ],
      "title": "Memory Usage",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "id": 5,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "showPoints": "never",
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "expr": "node_memory_MemAvailable_bytes{job=\"node\"}",
          "legendFormat": "mem available",
          "refId": "A"
        }
      ],
      "title": "Memory Available",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percent" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "id": 6,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "showPoints": "never",
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "expr": "topk(10, 100 * (1 - (node_filesystem_avail_bytes{job=\"node\", fstype!~\"tmpfs|overlay|squashfs\", mountpoint!~\"^/(proc|sys|dev)\"} / node_filesystem_size_bytes{job=\"node\", fstype!~\"tmpfs|overlay|squashfs\", mountpoint!~\"^/(proc|sys|dev)\"})))",
          "legendFormat": "{{mountpoint}} {{fstype}}",
          "refId": "A"
        }
      ],
      "title": "Disk Usage (Top Mounts)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
      "id": 7,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "showPoints": "never",
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "expr": "sum(rate(node_network_receive_bytes_total{job=\"node\", device!~\"lo\"}[5m]))",
          "legendFormat": "rx bytes/s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(node_network_transmit_bytes_total{job=\"node\", device!~\"lo\"}[5m]))",
          "legendFormat": "tx bytes/s",
          "refId": "B"
        }
      ],
      "title": "Network Throughput",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["rankalpha", "infra"],
  "templating": { "list": [] },
  "time": { "from": "now-3d", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "RankAlpha Host Health",
  "uid": "rankalpha-host-health",
  "version": 1,
  "weekStart": ""
}

